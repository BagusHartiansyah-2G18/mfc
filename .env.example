# ==============================================================================
# BGS Micro Front End Environment Configuration Example
# ==============================================================================

# Development Authentication Bypass
# Set 'true' to allow direct access to protected routes (/compUI, /user-management, /customer-portal) without login.
# Set 'false' to test full login authentication and role-based route guard.
userbypass=true
VITE_USER_BYPASS=true

# Server Ports
PORT_PORTAL=4200
PORT_COMP_UI=4201
PORT_USER_MGMT=4202
PORT_NOTED=4203

# Portal Configuration
VITE_BRAND_NAME="BGS Platform"
VITE_FEATURE_CONFIG_URL="/feature.yml"

# Remote Micro Frontend URLs (Module Federation)
VITE_COMP_UI_URL=http://localhost:4201/remoteEntry.js
VITE_USER_MGMT_URL=http://localhost:4202/remoteEntry.js
VITE_NOTED_URL=http://localhost:4203/remoteEntry.js

# Backend REST API (NestJS + Prisma) - Auth & Identity
PORT_API=3001
VITE_API_URL=http://localhost:3001/api

# Backend REST API (NestJS + Prisma) - Notes & Hierarchy Service
PORT_API_NOTED=3002
VITE_API_NOTED_URL=http://localhost:3002/api

# JWT Authentication Secret (Shared between api and api-noted)
JWT_SECRET="bgs-microfe-enterprise-secret-key-2026"

# Database Connection (MySQL 8.4)
DATABASE_URL="mysql://root:root@localhost:3306/bgs_user_mgmt"
DOCKER_DATABASE_URL="mysql://root:root@host.docker.internal:3306/bgs_user_mgmt"
DATABASE_NOTED_URL="mysql://root:root@host.docker.internal:3306/bgs_noted"
DOCKER_DATABASE_NOTED_URL="mysql://root:root@host.docker.internal:3306/bgs_noted"
