{
  "name": "userMgmt",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/userMgmt/src",
  "projectType": "application",
  "tags": ["scope:user-mgmt", "type:app"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "vite",
        "cwd": "apps/userMgmt"
      },
      "readyWhen": {
        "signal": true
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "vite build",
        "cwd": "apps/userMgmt"
      }
    }
  }
}
