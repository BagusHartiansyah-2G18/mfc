datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  isSystem    Boolean          @default(false) @map("is_system")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique @db.VarChar(50)
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  roleId       String    @map("role_id")
  status       String    @default("active") @db.VarChar(20) // 'active', 'inactive', 'suspended'
  lastLoginAt  DateTime? @map("last_login_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  profile      UserProfile?

  @@index([roleId])
  @@index([deletedAt])
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  phone       String?   @db.VarChar(30)
  address     String?   @db.Text
  gender      String?   @db.VarChar(20) // 'Laki-laki', 'Perempuan', 'Lainnya'
  birthDate   DateTime? @map("birth_date")
  jobTitle    String?   @map("job_title") @db.VarChar(100)
  department  String?   @db.VarChar(100)
  bio         String?   @db.Text
  avatarUrl   String?   @map("avatar_url") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Permission {
  id          String           @id @db.VarChar(50) // e.g. 'users:view', 'users:create'
  module      String           @db.VarChar(50)     // 'users', 'roles', 'projects', 'billing', 'audit_logs', 'settings'
  action      String           @db.VarChar(20)     // 'view', 'create', 'edit', 'delete'
  description String?          @db.VarChar(255)

  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id") @db.VarChar(50)
  assignedAt   DateTime   @default(now()) @map("assigned_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String   @db.VarChar(50) // e.g. 'USER_CREATED', 'USER_UPDATED', 'USER_DELETED', 'PASSWORD_RESET', 'ROLE_PERMISSIONS_UPDATED'
  entity     String   @db.VarChar(50) // 'User', 'Role', 'Permission'
  entityId   String?  @map("entity_id") @db.VarChar(100)
  actorId    String?  @map("actor_id") @db.VarChar(100)
  actorName  String?  @map("actor_name") @db.VarChar(150)
  details    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
